{
  "name": "sai-tiles-billing",
  "productName": "SAI TILES",
  "version": "1.0.0",
  "description": "Billing and inventory software for SAI TILES",
  "main": "src/main.js",
  "author": "SAI TILES",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "dist": "electron-builder --mac dmg",
    "dist:dir": "electron-builder --mac dir"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "playwright-core": "^1.64.1"
  },
  "build": {
    "appId": "com.saitiles.billing",
    "productName": "SAI TILES",
    "artifactName": "SAI-TILES-${version}-${arch}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "renderer/**/*",
      "shared/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.business",
      "identity": null,
      "target": [
        "dmg"
      ],
      "icon": "build/icon.icns"
    },
    "dmg": {
      "title": "SAI TILES ${version}"
    }
  }
}
